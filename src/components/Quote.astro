---
// Quote request: heading + phone card on the left, form on the right.
import { BUSINESS, SCOPE, FORM_ENDPOINT } from '../site';
---

<section id="quote" class="wrap section-y grid grid-cols-[minmax(0,1fr)] items-start gap-x-[88px] gap-y-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
  <div class="flex flex-col gap-[22px] lg:sticky lg:top-[130px]">
    <h2 data-reveal class="h-section">Request a quote</h2>
    <p data-reveal class="m-0 max-w-[28em] text-[19px] text-ink-3">
      Small project or large-scale development, we’d love the chance to quote it and talk about how we can help.
    </p>
    <div data-reveal class="mt-1.5 flex flex-col gap-1.5 bg-charcoal px-7 pt-7 pb-[30px] text-white">
      <span class="text-[15px] font-semibold text-tan">Call or text</span>
      <a href={BUSINESS.phoneHref} class="font-display text-[clamp(34px,3.4vw,50px)] leading-[1.1] font-extrabold tracking-[-0.02em] text-white no-underline hover:text-tan">{BUSINESS.phone}</a>
      <span class="mt-2 text-base text-on-dark-2">{BUSINESS.name} · {BUSINESS.city}, {BUSINESS.region}</span>
    </div>
  </div>

  <div>
    <form
      id="quote-form"
      data-reveal
      data-endpoint={FORM_ENDPOINT}
      action={FORM_ENDPOINT || undefined}
      method="post"
      enctype="multipart/form-data"
      class="flex flex-col gap-[18px] border-t-[5px] border-brick bg-white p-[clamp(24px,3vw,44px)]"
    >
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-[18px]">
        <label class="flex flex-col gap-[7px] text-[15px] font-bold">Company<input name="company" autocomplete="organization" class="field" /></label>
        <label class="flex flex-col gap-[7px] text-[15px] font-bold">Your name<input name="name" required autocomplete="name" class="field" /></label>
        <label class="flex flex-col gap-[7px] text-[15px] font-bold">Phone<input name="phone" type="tel" required autocomplete="tel" class="field" /></label>
        <label class="flex flex-col gap-[7px] text-[15px] font-bold">Email<input name="email" type="email" autocomplete="email" class="field" /></label>
      </div>
      <label class="flex flex-col gap-[7px] text-[15px] font-bold">Project location<input name="location" class="field" /></label>

      <fieldset class="m-0 flex flex-col gap-2.5 border-0 p-0">
        <legend class="mb-2.5 p-0 text-[15px] font-bold">Scope of work</legend>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-2.5">
          {
            SCOPE.map((c) => (
              <label class="flex cursor-pointer items-center gap-2.5 border-2 border-line px-[13px] py-[11px] text-[17px] font-medium has-checked:border-brick">
                <input type="checkbox" name="scope" value={c} class="m-0 h-[18px] w-[18px] accent-brick" />
                <span>{c}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="flex flex-col gap-[7px] text-[15px] font-bold">Project details and timeline<textarea name="details" rows="4" class="field resize-y"></textarea></label>
      <label class="flex flex-col gap-[7px] text-[15px] font-bold">
        Drawings or photos (optional)
        <input name="attachments" type="file" multiple class="min-w-0 border-2 border-dashed border-line bg-[#FAF8F4] p-3 text-base text-ink" />
      </label>

      <p id="quote-error" role="alert" hidden class="m-0 border-l-[3px] border-brick bg-[#FBEDE9] px-4 py-3 text-base text-ink"></p>

      <button type="submit" class="cursor-pointer self-start border-0 bg-brick px-8 py-[19px] text-lg font-bold whitespace-nowrap text-white hover:bg-charcoal disabled:cursor-wait disabled:opacity-70">
        Send request
      </button>
    </form>

    <div id="quote-thanks" hidden class="flex flex-col gap-3 border-t-[5px] border-brick bg-white p-[clamp(28px,3vw,48px)]" tabindex="-1">
      <span class="font-display text-[clamp(28px,3vw,42px)] leading-[1.05] font-extrabold tracking-[-0.02em]">Thanks. We’ll be in touch about your project.</span>
      <p class="m-0 text-lg text-ink-3">Need it sooner? Call {BUSINESS.phone}.</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const thanks = document.getElementById('quote-thanks')!;
  const error = document.getElementById('quote-error')!;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const endpoint = form.dataset.endpoint;

  const showError = (msg: string) => {
    error.textContent = msg;
    error.hidden = false;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;

    // Form isn't connected yet (see FORM_ENDPOINT in src/site.ts). Don't pretend it was sent.
    if (!endpoint) {
      showError('Online requests aren’t set up yet. Please call or text 604-889-9042.');
      return;
    }

    button.disabled = true;
    try {
      const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      thanks.hidden = false;
      thanks.focus();
    } catch {
      showError('Sorry, something went wrong sending your request. Please try again or call 604-889-9042.');
    } finally {
      button.disabled = false;
    }
  });
</script>
